  #bm-root .footer-spine{font-family:var(--font-display),Georgia,serif;font-style:italic;color:var(--forest);text-align:center;font-size:15px;margin:26px 0 6px;}
  #bm-root .restart{display:flex;justify-content:center;margin-top:18px;}

