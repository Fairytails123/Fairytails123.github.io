  /* Framed on the homepage: Base has already hidden the site chrome and every
     [data-frame-hide] section, so all that is left is the tool. Drop this page's
     own card and its section padding too — the homepage section already provides
     a card around the iframe, and doubling them reads as a box in a box. */
  html.is-framed [data-frame-flat]{background:transparent;box-shadow:none;padding:0;}
  html.is-framed [data-section="matcher"]{padding-top:.5rem;padding-bottom:.5rem;}
</style>

<!-- The tool itself. Engine, data, service links and UI all live in
     src/scripts/breed-matcher/ — the SINGLE source; there is no public/ copy. -->
<script>
  import '../../../scripts/breed-matcher/ui.js';
</script>

<!-- Page motion: standard y-only reveals + hero entrance. Never hides content
     (verify-reveals gate). Skipped entirely when framed — every animated section
     is display:none inside the homepage iframe, and driving ScrollTriggers on
     hidden elements only burns frames. -->
<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);
  let mm = null;

  function initBreedMatcherMotion() {
    if (window.self !== window.top) return; // framed: the animated sections are hidden
    const root = document.querySelector('[data-page="breed-matcher"]');
    if (!root || root.dataset.gsapInit) return;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduceMotion) return; // static page — everything already visible
    root.dataset.gsapInit = '1';

    mm = gsap.matchMedia();
    mm.add('(prefers-reduced-motion: no-preference)', () => {
      gsap
        .timeline({ defaults: { ease: 'power3.out' } })
        .from('[data-hero-eyebrow]', { y: 24, duration: 0.6 }, 0.1)
        .from('[data-hero-title] .hero-line', { y: 24, duration: 0.9, stagger: 0.14 }, 0.2)
        .from('[data-hero-sub]', { y: 24, duration: 0.7 }, 0.55)
        .from('[data-hero-cta] > *', { y: 18, duration: 0.55, stagger: 0.1 }, 0.72)
        .from('[data-hero-trust]', { y: 36, duration: 0.7 }, 0.85);

      gsap.utils.toArray('[data-reveal]').forEach((el) => {
        gsap.from(el, { y: 36, duration: 0.85, ease: 'power3.out', scrollTrigger: { trigger: el, start: 'top 88%', once: true } });
      });
      gsap.utils.toArray('[data-stagger]').forEach((group) => {
        gsap.from(group.children, { y: 28, duration: 0.7, ease: 'power3.out', stagger: 0.07, scrollTrigger: { trigger: group, start: 'top 88%', once: true } });
      });
    });
  }

  initBreedMatcherMotion();
  document.addEventListener('astro:page-load', initBreedMatcherMotion);
  document.addEventListener('astro:before-swap', () => {
    ScrollTrigger.getAll().forEach((t) => t.kill());
    if (mm) { mm.revert(); mm = null; }
  });
</script>
